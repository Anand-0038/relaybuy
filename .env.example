# Runtime
NODE_ENV=development
PRAVA_MODE=replay
APP_BASE_URL=http://localhost:3000
# Leave false unless the deployed platform's proxy-header contract is verified.
TRUST_PROXY_HEADERS=false

# Safety flags: off by default
REPLAY_MUTATIONS_ENABLED=false
PAYMENTS_ENABLED=false
ALLOW_PRAVA_SESSION_CREATION=false
ALLOW_PRAVA_LIVE_ORDER=false
PRAVA_MCP_CONTRACT_CONFIRMED=false
# Paste the JSON payload only after support@prava.space confirmation.
# Required fields: supportCaseId, confirmationDate, runtimeVersion, executionChain,
# postQuoteTotalChangeBehavior, localSchemaPrecedencePolicy,
# localSchemaContradictionResolution, timeoutRecoveryPolicy
# Example:
# PRAVA_MCP_CONTRACT_CONFIRMATION={"supportCaseId":"SUP-123456","confirmationDate":"2026-07-30T12:00:00Z","runtimeVersion":"mcp-<server version>","executionChain":"shop_quote -> create_payment_session -> approval -> shop_checkout","postQuoteTotalChangeBehavior":"<support-confirmed behavior>","localSchemaPrecedencePolicy":"<support-confirmed precedence>","localSchemaContradictionResolution":"<support-confirmed reason>","timeoutRecoveryPolicy":"<support-confirmed policy>"}

# Database
DATABASE_URL=
DATABASE_SSL=require
LIVE_REQUEST_TTL_MINUTES=180

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_FALLBACK_MODEL=gpt-5.6-sol
PRAVA_USER_ID=relaybuy-sandbox-user
PRAVA_USER_EMAIL=sandbox-user@relaybuy.app
PRAVA_MERCHANT_COUNTRY=US
OPENAI_EXTRACTION_ENABLED=false
OPENAI_AGENTS_DISABLE_TRACING=1
OPENAI_TRACE_INCLUDE_SENSITIVE_DATA=false

# Prava sandbox only
PRAVA_ENV=sandbox
PRAVA_MERCHANT_SECRET_KEY=
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=
PRAVA_REQUEST_TIMEOUT_MS=45000

# Public security contact
RELAYBUY_SECURITY_EMAIL=security@a2zbtc.com

# Linq optional
LINQ_ENABLED=false
LINQ_BEARER_TOKEN=
LINQ_PHONE_NUMBER_ID=
LINQ_WEBHOOK_SECRET=

# Senso optional
SENSO_ENABLED=false
SENSO_API_KEY=
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1
SENSO_MIN_SCORE=0.35
# JSON array emitted by scripts/sync-canonical-evidence.mjs. Authorization is
# bound to the exact content ID, version ID, and structured-record SHA-256.
SENSO_POLICY_BINDINGS=[]

# Manager approval
# Generate a random value with at least 32 characters. Never expose it publicly.
APPROVAL_TOKEN_PEPPER=
READINESS_PROBE_TOKEN=

# Attachments optional
BLOB_READ_WRITE_TOKEN=
# Real merchant execution is opt-in and requires a genuine server-only billing
# profile. Never expose these values through NEXT_PUBLIC_* variables.
RELAYBUY_MERCHANT_ATTEMPT_ENABLED=false
RELAYBUY_CHECKOUT_EMAIL=
RELAYBUY_CHECKOUT_CARDHOLDER_NAME=
RELAYBUY_CHECKOUT_FIRST_NAME=
RELAYBUY_CHECKOUT_LAST_NAME=
RELAYBUY_CHECKOUT_ADDRESS1=
RELAYBUY_CHECKOUT_CITY=
RELAYBUY_CHECKOUT_REGION=
RELAYBUY_CHECKOUT_POSTAL_CODE=
RELAYBUY_CHECKOUT_COUNTRY_CODE=US
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
